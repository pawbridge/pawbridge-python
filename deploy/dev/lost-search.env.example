# Dedicated dev settings only. Secret placeholders must be replaced outside Git.
PAWBRIDGE_ENVIRONMENT=dev
LOST_STORAGE_BACKEND=postgresql
LOST_PG_DSN=postgresql://pawbridge_dev_vector:<DEV_PASSWORD>@127.0.0.1:15433/pawbridge
LOST_PG_POOL_MAX_SIZE=2
INTERNAL_API_KEY=<DEV_INTERNAL_API_KEY>
LOST_SEARCH_VISUAL_PROFILE=sam3-animal-focus
LOST_SEARCH_INDEX=animals-lost-dinov3-sam3-dev-v1
LOST_GALLERY_STATE_DIR=/home/shyu/pawbridge-ai-dev/state
LOST_GALLERY_PHOTO_ROOT=/home/shyu/pawbridge-ai-dev/photos
LOST_GALLERY_SYNC_ENABLED=false
LOST_GALLERY_PROTOCOL=v2
# Explicit capacity review is required before enabling a second GPU process.
LOST_DEV_GPU_ENABLED=false
# Read-only existing model files may be shared; process state and DB must not be.
DINOV3_CHECKPOINT=<EXISTING_DINOV3_CHECKPOINT>
SAM3_CHECKPOINT=<EXISTING_SAM3_CHECKPOINT>
