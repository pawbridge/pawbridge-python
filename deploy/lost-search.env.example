# Copy outside Git with mode 0600. Replace paths and keys before enabling.
INTERNAL_API_KEY=REPLACE_WITH_SEARCH_INTERNAL_KEY
ES_URL=http://127.0.0.1:19201
LOST_SEARCH_VISUAL_PROFILE=sam3-animal-focus
LOST_SEARCH_INDEX=animals-lost-dinov3-sam3-gallery-v1
DINOV3_CHECKPOINT=/REPLACE_WITH_HOME/.local/share/pawbridge-ai/models/dinov3-large-30c1109/model.safetensors
SAM3_CHECKPOINT=/REPLACE_WITH_HOME/.local/share/pawbridge-ai/models/sam3-9999e234/sam3.pt
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
OMP_NUM_THREADS=2
# Enable only after the actual authenticated feed and access tunnel have been verified.
LOST_GALLERY_SYNC_ENABLED=false
LOST_GALLERY_SOURCE_URL=http://127.0.0.1:18082/internal/animals/lost-gallery
LOST_GALLERY_SOURCE_KEY=REPLACE_WITH_DEDICATED_GALLERY_KEY
LOST_GALLERY_R2_HOST=3e28b8ba8375b9010f6a426c1cb9755f.r2.cloudflarestorage.com
LOST_GALLERY_STATE_DIR=/REPLACE_WITH_HOME/.local/state/pawbridge/lost-gallery
LOST_GALLERY_PHOTO_ROOT=/REPLACE_WITH_HOME/.cache/pawbridge/lost-gallery/photos
LOST_GALLERY_INTERVAL_SECONDS=900

# 0 preserves existing ranks. Enable only after color backfill and quality evaluation (max 0.2).
LOST_SEARCH_COAT_COLOR_WEIGHT=0
