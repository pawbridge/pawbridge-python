[Unit]
Description=PawBridge local GPU lost animal search and gallery refresh
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/pawbridge-ai/current
EnvironmentFile=%h/.config/pawbridge/lost-search.env
ExecStart=%h/pawbridge-ai/venv/bin/python -m uvicorn app.lost_main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
