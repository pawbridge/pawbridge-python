FROM python:3.11-slim
WORKDIR /service
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-photo.txt .
RUN pip install --no-cache-dir -r requirements-photo.txt
COPY app/photo_optimizer.py app/photo_main.py ./app/
USER 65532:65532
EXPOSE 8000
CMD ["uvicorn", "app.photo_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "4", "--backlog", "8"]
